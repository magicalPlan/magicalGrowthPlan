{
  // 마법 성장기록 · Realtime Database 규칙
  // ADMIN = 운영자(admins 목록에 있는 계정). admins 목록은 콘솔에서만 고칠 수 있다.
  "rules": {
    ".read": false,
    ".write": false,

    // 운영자 목록: 로그인한 사람은 읽기만. 추가·삭제는 Firebase 콘솔에서 직접.
    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    // 내 캐릭터 저장: 본인만 읽고 쓴다. (비밀 코드 없이 누구나 가입할 수 있다)
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // 플레이어 공개 정보(등록자 목록·프로필·접속 표시 등): 로그인한 사람은 모두 읽기, 쓰기는 본인만.
    // 공지(ntc)·시즌 초기화(rst)는 운영자 본인의 이 칸에 저장된다. 멸망까지는 doom 한 칸이다.
    "players": {
      ".read": "auth != null",
      ".indexOn": ["pw", "lv", "gr"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // 단체·마을 채팅과 게시판(b_), 게시판 사진(bimg_): 모두 읽기. 새 글은 본인 이름으로만, 지우기·고치기는 쓴 사람이나 운영자만.
    "chat": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.exists() && (data.child('u').val() === auth.uid || root.child('admins').child(auth.uid).exists())) || (data.exists() && data.child('bt').val() === 'p' && newData.child('bt').val() === 'p' && newData.child('u').val() === data.child('u').val() && newData.child('ti').val() === data.child('ti').val() && newData.child('x').val() === data.child('x').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('n').val() === data.child('n').val() && newData.child('img').val() === data.child('img').val() && newData.child('cc').isNumber()))"
      }
    },

    // 1:1 대화: 대화 당사자만 자기 대화(k)를 찾아 읽을 수 있다. 운영자는 전체 열람.
    // ★ .indexOn 'k' 가 꼭 있어야 한다. 빠지면 게임이 대화 1,500개를 통째로 2.5초마다 받는다(이번 요금 폭탄의 유력한 원인).
    "dm": {
      ".indexOn": ["k"],
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (query.orderByChild === 'k' && query.equalTo != null && query.equalTo.contains(auth.uid)))",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && newData.child('k').val().contains(auth.uid)"
      }
    },

    // 받는 사람만 읽는 우편함들: 1:1 새 메시지 표시(dmn), 친구 신청·수락(fmsg), 공명(res), 선물(gift).
    // 경로는 {받는 사람}/{보낸 사람}. 보내는 사람은 자기 칸에만 쓴다.
    "dmn": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.uid === $from"
        }
      }
    },
    "fmsg": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.uid === $from"
        }
      }
    },
    // 공명: 같은 상대에게 3시간에 한 번
    "res": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.uid === $from && (!data.exists() || data.child('ts').val() < now - 10800000)"
        }
      }
    },
    // 선물 도착 표시: 받는 사람이 앉아 있는 동안 칸 전체 대신 이 시각만 본다. 보내는 사람은 자기 uid만 남긴다.
    "giftn": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        ".write": "auth != null && newData.exists() && newData.child('u').val() === auth.uid && newData.child('g').isString() && newData.child('g').val().length <= 8 && newData.child('n').isString() && newData.child('n').val().length <= 20"
      }
    },
    // 선물: 같은 친구에게 하루 4개(칸 0~3), 한 칸은 24시간 뒤에 다시 쓸 수 있다
    "gift": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          "$i": {
            ".write": "auth != null && auth.uid === $from && ($i === '0' || $i === '1' || $i === '2' || $i === '3') && (!data.exists() || data.child('ts').val() < now - 86400000)"
          }
        }
      }
    },

    // 마을 경쟁: guard/{주}/{마을}/{나}. 모두 읽기, 내 점수만 쓰기.
    "guard": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$wk": {
        "$v": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    // 운영자 공지(예전 방식): 모두 읽기, 운영자만 쓰기
    "notice": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    // 멸망까지: 기간은 이 칸 하나. 로그인한 사람은 읽고, 운영자만 시작일을 고친다.
    "doom": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists() && (!newData.exists() || (newData.child('ts').isNumber() && (newData.child('off').val() === 1 || (newData.child('d').isString() && newData.child('d').val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)))))"
    },

    // 마수 포탈: portal/{포탈}/j(출동)·h(치유)/{나}
    "portal": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        "j": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "h": { "$uid": { ".write": "auth != null && auth.uid === $uid" } }
      }
    },

    // 타락 레이드: raid/{타락한 사람}은 본인만, raidhit/{타락한 사람}/{레이드}/{공격한 사람}은 공격한 본인만
    "raid": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "raidhit": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$u": {
        ".write": "auth != null && auth.uid === $u",
        "$rid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    // 보스·웨이브 기록과 프로필 큰 사진·시계 맞추기: wboss/{보스·웨이브·pic·picm·clk}/{나}
    "wboss": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() && $k !== 'pic' && $k !== 'picm' && $k !== 'clk'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    // 마을 시설 단계. score·players 와 별개다. vfac/{A|B|C|D}/{시설키} = { t:표시 이름, sum:전체 기여, lv:단계 }
    // 사람별 기여는 vfactop 에 두고, 화면은 그 중 상위 5명만 읽는다.
    "vfac": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$v": {
        "$k": {
          ".write": "auth != null && ($v === 'A' || $v === 'B' || $v === 'C' || $v === 'D') && newData.child('sum').isNumber() && newData.child('sum').val() >= 0 && newData.child('sum').val() <= 100000000 && newData.child('lv').isNumber() && newData.child('lv').val() === (newData.child('sum').val() >= 5000 ? 5 : newData.child('sum').val() >= 3000 ? 4 : newData.child('sum').val() >= 1600 ? 3 : newData.child('sum').val() >= 800 ? 2 : newData.child('sum').val() >= 300 ? 1 : 0) && (!data.exists() || newData.child('sum').val() >= data.child('sum').val()) && (($k === 'spring' && newData.child('t').val() === '치유의 샘') || ($k === 'forge' && newData.child('t').val() === '대장간') || ($k === 'drill' && newData.child('t').val() === '훈련장') || ($k === 'tower' && newData.child('t').val() === '감시탑') || ($k === 'market' && newData.child('t').val() === '시장') || ($k === 'chapel' && newData.child('t').val() === '성당') || ($k === 'library' && newData.child('t').val() === '서고') || ($k === 'workshop' && newData.child('t').val() === '공방'))"
        }
      }
    },
    "vfactop": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$v": {
        "$k": {
          ".indexOn": ["pt"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ($v === 'A' || $v === 'B' || $v === 'C' || $v === 'D') && ($k === 'spring' || $k === 'forge' || $k === 'drill' || $k === 'tower' || $k === 'market' || $k === 'chapel' || $k === 'library' || $k === 'workshop') && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('pt').isNumber() && newData.child('pt').val() >= 0 && newData.child('pt').val() <= 1000000 && (!data.exists() || newData.child('pt').val() >= data.child('pt').val())"
          }
        }
      }
    },

    // 사진 없는 명부. 접속 시각(on)으로 최근 접속만 골라 읽는다. 채팅 사진은 그 사람의 players/{나}/im 만 따로 받는다.
    "who": {
      ".read": "auth != null",
      ".indexOn": ["on"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.child('n').isString() && newData.child('n').val().length > 0 && newData.child('n').val().length <= 20 && newData.child('on').isNumber() && newData.child('pw').isNumber() && newData.child('pw').val() >= 0 && newData.child('pw').val() <= 100000000"
      }
    },

    // 등대 합계·재해 진압 합계·방 정리 자물쇠. score 전체를 읽지 않기 위한 칸.
    // wf 는 합계가 줄어들지 않을 때만. 재해 점수도 줄어들지 않을 때만. 시드는 한 클라이언트가 score 를 한 번 옮겨 적을 때 쓴다.
    "tally": {
      ".read": "auth != null",
      "wf": {
        ".write": "auth != null && newData.child('sum').isNumber() && newData.child('sum').val() >= 0 && newData.child('sum').val() <= 100000000 && newData.child('A').isNumber() && newData.child('B').isNumber() && newData.child('C').isNumber() && newData.child('D').isNumber() && (!data.exists() || newData.child('sum').val() >= data.child('sum').val())"
      },
      "dr": {
        "$id": {
          ".write": "auth != null && newData.child('pts').isNumber() && newData.child('pts').val() >= 0 && newData.child('pts').val() <= 100000 && (!data.exists() || newData.child('pts').val() >= data.child('pts').val())"
        }
      },
      "seed": {
        ".write": "auth != null && newData.child('at').isNumber() && newData.child('u').val() === auth.uid"
      },
      "roomsweep": {
        ".write": "auth != null && newData.child('at').isNumber() && newData.child('u').val() === auth.uid"
      }
    },

    // 시설·등대·재해 기여만 모은 작은 기록. 사진이 든 등록자 전체는 읽지 않는다. 본인 칸만 쓴다.
    // 화면은 이 목록 전체를 받지 않는다. 합계는 tally·vfac 를 읽고, 이 칸은 본인 기록과 한 번의 옮겨 적기용이다.
    "score": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // 파티 방·정기 출정 자리와 투표·대련·1:1 알림 신호: 여러 사람이 함께 쓰고 정리하는 곳이라 로그인한 사람에게 열어 둔다(예전과 같음)
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
