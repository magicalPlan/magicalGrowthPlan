      "nodes": {
        "once_apon_a_time": {
          "lines": [
            {
              "who": "",
              "text": "옛날옛적에, 가난한 우유 배달부 소년과 개 한 마리가 함께 살았습니다."
            },
            {
              "who": "",
              "text": "..."
            },
            {
              "who": "",
              "text": "살았던 적이, 있었습니다."
            },
            {
              "who": "",
              "text": "조금 가까운 현재에, 모든 것을 잃은 '플랜더스의 화가'가 살았습니다."
            },
            {
              "who": "flanders_artist_default",
              "text": "...포기 안 해."
            },
            {
              "who": "flanders_artist_default",
              "text": "포기 안 할 거야."
            },
            {
              "who": "flanders_artist_default",
              "text": "그 아이를 위해서."
            },
            {
              "who": "flanders_artist_default",
              "text": "꿈을 위해서."
            },
            {
              "who": "flanders_artist_default",
              "text": "나는, 절대로...!"
            },
            {
              "who": "",
              "text": "그 순간."
            },
            {
              "who": "",
              "text": "절망한 소년의 손을, 새하얀 개가 핥짝였습니다."
            },
            {
              "who": "flanders_artist_default",
              "text": "...파트라슈."
            }, 
            {
              "who": "flanders_artist_default",
              "text": "이런, 미안. 내가 물 주는 걸 깜박했구나. 미안해."
            },
            {
              "who": "flanders_artist_default",
              "text": "금방, 금방 줄 테니까..."
            },
            {
              "who": "flanders_artist_default",
              "text": "그런 눈으로."
            },
            {
              "who": "flanders_artist_default",
              "text": "그런 눈으로, 보지 마..."
            },
            {
              "who": "",
              "text": "소년은 파트라슈를 꽉 끌어안았습니다."
            },
            {
              "who": "flanders_artist_default",
              "text": "..."
            },
            {
              "who": "flanders_artist_default",
              "text": "포기 안 할게."
            },
            {
              "who": "flanders_artist_default",
              "text": "이건, 널 포기하는 게 아니야."
            },
            {
              "who": "flanders_artist_default",
              "text": "놓아주는 거지..."
            },
            {
              "who": "flanders_artist_default",
              "text": "이별은 포기 같은 게 아니야."
            },
            {
              "who": "flanders_artist_default",
              "text": "누군가를 향한 응원일 거야."
            },
            {
              "who": "flanders_artist_default",
              "text": "그렇게 생각하지 않으면..."
            },
            {
              "who": "flanders_artist_default",
              "text": "...응, 그렇게 생각할 거야."
            },
            {
              "who": "",
              "text": "소년은 개를 놓아주었습니다."
            },
            {
              "who": "nero_default",
              "text": "그래, 우유배달만 하는 건 지겨웠지?"
            },
            {
              "who": "nero_default",
              "text": "널 보내줄게."
            },
            {
              "who": "nero_default",
              "text": "더 먼 세상을 여행해."
            },
            {
              "who": "nero_default",
              "text": "나는, 음..."
            },
            {
              "who": "nero_default",
              "text": "좀 더, 이곳을 탐험할게."
            },
            {
              "who": "",
              "text": "어느덧, 파트라슈의 몸이 투명해지기 시작했고..."
            },
            {
              "who": "nero_default",
              "text": "잘 가, 파트라슈."
            },
            {
              "who": "nero_default",
              "text": "잘 가, 내 꿈."
            },
            {
              "who": "nero_default",
              "text": "잘 가, 잘 가, 잘 가."
            },
            {
              "who": "nero_default",
              "text": "즐거운 여행 되길..."
            },
            {
              "who": "",
              "text": "소년은, 모든 걸 잃었습니다."
            }
          ]
        }
      }
    },
